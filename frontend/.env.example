# ========================================================
# Frontend Environment Variables (React Native / Expo)
# ========================================================

# Base URL for the Backend REST API
# Default for Web Browser & iOS Simulator:
EXPO_PUBLIC_API_URL=http://localhost:5001/api

# For Android Emulator (10.0.2.2 maps to host machine localhost):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5001/api

# For Physical Device on same Wi-Fi network:
# EXPO_PUBLIC_API_URL=http://192.168.1.X:5001/api
