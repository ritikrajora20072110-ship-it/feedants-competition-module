# ========================================================
# Backend Environment Variables (Node.js + Express)
# ========================================================

# Server Port
PORT=5001

# Environment ('development' or 'production')
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB instance:
MONGODB_URI=mongodb://127.0.0.1:27017/feedants_db

# MongoDB Atlas (Cloud) Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/feedants_db?retryWrites=true&w=majority

# Optional: Razorpay Credentials (for production webhook/payment validation)
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxx
